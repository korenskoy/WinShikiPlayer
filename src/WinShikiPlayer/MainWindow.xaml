<Window x:Class="WinShikiPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:WinShikiPlayer.Controls">
  <Grid x:Name="Root" Background="{StaticResource CanvasBrush}" SizeChanged="Root_SizeChanged">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
      <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="Forward_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="{StaticResource SurfaceBrush}" Padding="16,0">
      <TextBlock Text="WinShikiPlayer" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
    </Grid>
    <Grid x:Name="AppHeader" Grid.Row="1" Padding="24,10" ColumnSpacing="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,8,0">
        <Border CornerRadius="6">
          <Image Source="Assets/AppIcon.png" Width="28" Height="28" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="17" FontWeight="ExtraBold">
            <Run Text="winshiki" />
            <Run Text="." Foreground="{StaticResource AccentBrush}" />
          </TextBlock>
          <TextBlock Text="КАТАЛОГ + ПЛЕЕР" FontSize="7" CharacterSpacing="160" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="Back_Click" IsEnabled="False" ToolTipService.ToolTip="Назад · Alt+←" AutomationProperties.Name="Назад">
          <FontIcon Glyph="" FontSize="13" />
        </Button>
        <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="Forward_Click" IsEnabled="False" ToolTipService.ToolTip="Вперёд · Alt+→" AutomationProperties.Name="Вперёд">
          <FontIcon Glyph="" FontSize="13" />
        </Button>
      </StackPanel>
      <StackPanel x:Name="Nav" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Tag="home" Click="Navigate_Click" Style="{StaticResource NavButton}" ToolTipService.ToolTip="Главная" AutomationProperties.Name="Главная">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="" FontSize="14" />
            <TextBlock Text="Главная" />
          </StackPanel>
        </Button>
        <Button Tag="catalog" Click="Navigate_Click" Style="{StaticResource NavButton}" ToolTipService.ToolTip="Каталог" AutomationProperties.Name="Каталог">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="" FontSize="14" />
            <TextBlock Text="Каталог" />
          </StackPanel>
        </Button>
        <Button Tag="library" Click="Navigate_Click" Style="{StaticResource NavButton}" ToolTipService.ToolTip="Мои списки" AutomationProperties.Name="Мои списки">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="" FontSize="14" />
            <TextBlock Text="Мои списки" />
          </StackPanel>
        </Button>
        <Button Tag="calendar" Click="Navigate_Click" Style="{StaticResource NavButton}" ToolTipService.ToolTip="Календарь" AutomationProperties.Name="Календарь">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="" FontSize="14" />
            <TextBlock Text="Календарь" />
          </StackPanel>
        </Button>
        <Button Tag="social" Click="Navigate_Click" Style="{StaticResource NavButton}" ToolTipService.ToolTip="Лента" AutomationProperties.Name="Лента">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="" FontSize="14" />
            <TextBlock Text="Лента" />
          </StackPanel>
        </Button>
        <Button Tag="history" Click="Navigate_Click" Style="{StaticResource NavButton}" ToolTipService.ToolTip="История" AutomationProperties.Name="История">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="" FontSize="14" />
            <TextBlock Text="История" />
          </StackPanel>
        </Button>
      </StackPanel>
      <AutoSuggestBox x:Name="SearchBox" Grid.Column="3" Width="230" PlaceholderText="Найти аниме…" QueryIcon="Find" VerticalAlignment="Center" QuerySubmitted="Search_Submitted" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" FontSize="12">
        <AutoSuggestBox.KeyboardAccelerators>
          <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="Search_Invoked" />
        </AutoSuggestBox.KeyboardAccelerators>
      </AutoSuggestBox>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Click="Settings_Click" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Настройки" AutomationProperties.Name="Настройки">
          <FontIcon Glyph="" FontSize="15" />
        </Button>
        <Button x:Name="AccountButton" Click="Account_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="Аккаунт Shikimori">
          <Grid>
            <Ellipse x:Name="AccountAvatar" Width="28" Height="28" Fill="{StaticResource AccentBrush}" />
            <TextBlock x:Name="AccountInitial" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentInkBrush}" />
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
    <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" Margin="24,8,24,0" Severity="Error" />
    <Grid Grid.Row="3">
      <Grid x:Name="BrowseView" ColumnSpacing="28" Padding="28,22,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="FilterPanel" Width="200" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,20">
          <StackPanel x:Name="FilterContent" Spacing="22" />
        </ScrollViewer>
        <ScrollViewer x:Name="BrowseScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" SizeChanged="Browse_SizeChanged">
          <StackPanel Spacing="18" Padding="0,0,8,28">
            <Grid x:Name="BrowseHeading" ColumnSpacing="14" RowSpacing="14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="5">
                <TextBlock x:Name="PageTitle" Text="Главная" FontSize="27" FontWeight="Bold" />
                <TextBlock x:Name="PageSubtitle" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="CatalogTools" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel x:Name="SortChips" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                <Button x:Name="SortMenuButton" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Все варианты сортировки">
                  <FontIcon Glyph="" FontSize="14" />
                  <Button.Flyout>
                    <Flyout>
                      <ComboBox x:Name="SortOrder" Width="230" Header="Сортировка" SelectedIndex="0" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="По популярности" Tag="popularity" />
                        <ComboBoxItem Content="По рейтингу" Tag="ranked" />
                        <ComboBoxItem Content="По дате выхода" Tag="aired_on" />
                        <ComboBoxItem Content="По названию" Tag="name" />
                        <ComboBoxItem Content="По моей оценке" Tag="rate_score" />
                        <ComboBoxItem Content="По обновлению списка" Tag="rate_updated" />
                        <ComboBoxItem Content="По числу серий" Tag="episodes" />
                        <ComboBoxItem Content="По типу" Tag="kind" />
                        <ComboBoxItem Content="По статусу" Tag="status" />
                        <ComboBoxItem Content="Случайный рейтинг" Tag="ranked_random" />
                      </ComboBox>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="2">
                  <StackPanel x:Name="ViewSwitch" Orientation="Horizontal" Spacing="1">
                    <Button Tag="grid" Click="ViewButton_Click" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Постеры">
                      <FontIcon Glyph="" FontSize="14" />
                    </Button>
                    <Button Tag="dense" Click="ViewButton_Click" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Компактно">
                      <TextBlock Text="▦" FontSize="17" FontFamily="Segoe UI Symbol" />
                    </Button>
                    <Button Tag="rows" Click="ViewButton_Click" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Строки">
                      <FontIcon Glyph="" FontSize="14" />
                    </Button>
                  </StackPanel>
                </Border>
                <ComboBox x:Name="ViewMode" SelectionChanged="ViewMode_Changed" SelectedIndex="0" Visibility="Collapsed">
                  <ComboBoxItem Content="Постеры" Tag="grid" />
                  <ComboBoxItem Content="Компактно" Tag="dense" />
                  <ComboBoxItem Content="Строки" Tag="rows" />
                </ComboBox>
              </StackPanel>
              <Button Grid.Column="1" Content="↻" HorizontalAlignment="Right" Click="Refresh_Click" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Обновить" AutomationProperties.Name="Обновить" VerticalAlignment="Top" />
            </Grid>
            <ScrollViewer x:Name="LibraryTabsHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="LibraryTabs" Orientation="Horizontal" Spacing="7" />
            </ScrollViewer>
            <ComboBox x:Name="LibraryStatus" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="LibraryStatus_Changed">
              <ComboBoxItem Content="Все списки" Tag="" />
              <ComboBoxItem Content="Смотрю" Tag="watching" />
              <ComboBoxItem Content="Запланировано" Tag="planned" />
              <ComboBoxItem Content="Просмотрено" Tag="completed" />
              <ComboBoxItem Content="Отложено" Tag="on_hold" />
              <ComboBoxItem Content="Брошено" Tag="dropped" />
              <ComboBoxItem Content="Пересматриваю" Tag="rewatching" />
            </ComboBox>
            <ui:FlowPanel x:Name="ActiveFilters" Spacing="6" Visibility="Collapsed" />
            <Border x:Name="Hero" Visibility="Collapsed" Height="360" CornerRadius="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <Image x:Name="HeroBackdrop" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.12" />
                <Border Grid.ColumnSpan="2">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                      <GradientStop x:Name="HeroShadeStart" Color="#FF0B0A0D" Offset="0" />
                      <GradientStop x:Name="HeroShadeMiddle" Color="#ED0B0A0D" Offset="0.38" />
                      <GradientStop x:Name="HeroShadeEnd" Color="#200B0A0D" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Image x:Name="HeroImage" Grid.Column="1" Stretch="Uniform" Margin="0,24,32,24" HorizontalAlignment="Right" VerticalAlignment="Stretch" />
                <StackPanel Padding="40,32" Spacing="14" VerticalAlignment="Center" MaxWidth="680" HorizontalAlignment="Left">
                  <TextBlock Text="СЕЙЧАС В ЭФИРЕ" Foreground="{StaticResource AccentBrush}" Style="{StaticResource SectionLabel}" />
                  <TextBlock x:Name="HeroTitle" FontSize="42" FontWeight="ExtraBold" TextWrapping="Wrap" MaxLines="2" />
                  <TextBlock x:Name="HeroMeta" Foreground="{StaticResource SecondaryBrush}" FontSize="13" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button Content="▶  Смотреть" Click="HeroPlay_Click" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="HeroButton" Content="Подробнее" Click="Hero_Click" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel x:Name="ContinueSection" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="Продолжить просмотр" FontSize="21" FontWeight="Bold" />
              <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <GridView x:Name="ContinueGrid" ItemTemplate="{StaticResource ContinueTemplate}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Anime_Click" ItemContainerStyle="{StaticResource PosterItem}">
                  <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </GridView.ItemsPanel>
                </GridView>
              </ScrollViewer>
            </StackPanel>
            <TextBlock x:Name="GridTitle" Text="Популярное сейчас" FontSize="21" FontWeight="Bold" />
            <StackPanel x:Name="FeatureToolbar" Orientation="Horizontal" Spacing="8" />
            <ProgressRing x:Name="Loading" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" />
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="12" Padding="0,40" MaxWidth="560" HorizontalAlignment="Left">
              <FontIcon Glyph="" FontSize="32" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
              <TextBlock x:Name="EmptyTitle" Text="Пока ничего нет" FontSize="24" FontWeight="Bold" />
              <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
              <Button x:Name="SignInPrompt" Content="Войти в Shikimori" Click="Account_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <GridView x:Name="AnimeGrid" ItemTemplate="{StaticResource AnimeTemplate}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Anime_Click" ItemContainerStyle="{StaticResource PosterItem}" SizeChanged="PosterGrid_SizeChanged" />
            <ListView x:Name="AnimeRows" ItemTemplate="{StaticResource AnimeRowTemplate}" ItemContainerStyle="{StaticResource RowItem}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Anime_Click" Visibility="Collapsed" />
            <StackPanel x:Name="ExtraHomeSections" Spacing="24" Visibility="Collapsed" />
            <ListView x:Name="TopicsList" Visibility="Collapsed" MaxWidth="780" HorizontalAlignment="Left" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Topic_Click" ItemContainerStyle="{StaticResource RowItem}">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{Binding User.Nickname}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="3" FontSize="13" Foreground="{StaticResource SecondaryBrush}" />
                      <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="LoadMore" Content="Загрузить ещё" Click="LoadMore_Click" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,16" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <ScrollViewer x:Name="DetailView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="DetailContent" Spacing="0" />
      </ScrollViewer>
      <ScrollViewer x:Name="FeatureView" Visibility="Collapsed" Padding="36,24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FeatureContent" Spacing="24" />
      </ScrollViewer>
      <Grid x:Name="PlayerView" Visibility="Collapsed" Background="Black" RequestedTheme="Dark" KeyboardAcceleratorPlacementMode="Hidden" PointerMoved="Player_PointerMoved" SizeChanged="Player_SizeChanged">
        <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Space" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="Left" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="Right" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="Up" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="Down" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="M" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="F" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="S" Invoked="PlayerShortcut_Invoked" />
      <KeyboardAccelerator Key="Escape" Invoked="PlayerShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
          <SolidColorBrush x:Key="PlayerAccent" Color="#FF4D5E" />
          <Style x:Key="PlayerIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="Transparent" /><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
          </Style>
          <Style x:Key="PlayerPill" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#14FFFFFF" /><Setter Property="BorderBrush" Value="#26FFFFFF" /><Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="34" />
          </Style>
        </Grid.Resources>
        <MediaPlayerElement x:Name="NativePlayer" AreTransportControlsEnabled="False" IsHitTestVisible="False" />
        <Grid x:Name="VideoTouchSurface" Background="Transparent" Tapped="Video_Tapped" DoubleTapped="Video_DoubleTapped" />
        <Image x:Name="AssOverlay" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
        <Grid x:Name="WebPlayerHost" Visibility="Collapsed" />
        <Grid x:Name="PlayerChrome">
          <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Grid.OpacityTransition>
          <Border Height="120" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A6000000" Offset="0" /><GradientStop Color="#00000000" Offset="1" /></LinearGradientBrush></Border.Background>
          </Border>
          <Grid x:Name="PlayerTopBar" VerticalAlignment="Top" Margin="12,16,28,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
            <Button Click="ClosePlayer_Click" Style="{StaticResource PlayerIcon}" Width="140" ToolTipService.ToolTip="Закрыть плеер · Esc">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE76B;" FontSize="14" /><TextBlock Text="Назад к аниме" FontSize="12" /></StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock x:Name="PlayerTitle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="White" />
              <TextBlock x:Name="PlayerEpisodeLabel" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="10" CharacterSpacing="150" Foreground="#8CFFFFFF" />
            </StackPanel>
            <Button x:Name="PinPlayerButton" Grid.Column="2" HorizontalAlignment="Right" Click="PinPlayer_Click" Style="{StaticResource PlayerPill}" Width="32" Padding="0" AutomationProperties.Name="Поверх других окон" ToolTipService.ToolTip="Поверх других окон: выкл"><FontIcon x:Name="PinPlayerIcon" Glyph="&#xE718;" FontSize="14" /></Button>
          </Grid>
          <TextBlock x:Name="PlayerStatus" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="40,76,40,0" Height="36" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" />
          <Border Height="220" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#D9000000" Offset="1" /></LinearGradientBrush></Border.Background>
          </Border>
          <StackPanel VerticalAlignment="Bottom" Spacing="12" Margin="28,0,28,20">
            <ui:ChapterScrubber x:Name="SeekTimeline" />
            <Grid x:Name="PlayerBottomBar" ColumnSpacing="14" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel x:Name="PlayerTransport" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" FontFamily="Consolas" Foreground="White" FontSize="13" VerticalAlignment="Center" />
                <Button Click="Rewind_Click" Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Назад 10 с · ←" AutomationProperties.Name="Назад 10 секунд"><ui:SeekIcon /></Button>
                <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Background="{StaticResource PlayerAccent}" Foreground="#0B0A0D" BorderThickness="0" Width="52" Height="52" Padding="0" CornerRadius="26" AutomationProperties.Name="Пуск / пауза" ToolTipService.ToolTip="Пуск / пауза · Space"><FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" /></Button>
                <Button Click="FastForward_Click" Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Вперёд 10 с · →" AutomationProperties.Name="Вперёд 10 секунд"><ui:SeekIcon Forward="True" /></Button>
                <Button Click="Skip80_Click" Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Вперёд 80 с" AutomationProperties.Name="Вперёд 80 секунд"><ui:SeekIcon Forward="True" Plus="True" /></Button>
                <StackPanel x:Name="PlayerVolume" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Click="Mute_Click" Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Звук · M" AutomationProperties.Name="Включить / выключить звук"><FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" /></Button>
                  <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8" StepFrequency="0.01" SmallChange="0.05" LargeChange="0.1" IsThumbToolTipEnabled="False" ValueChanged="Volume_Changed" Foreground="White" AutomationProperties.Name="Громкость"><Slider.Resources><SolidColorBrush x:Key="SliderThumbBackground" Color="White" /><SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" /><SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" /><SolidColorBrush x:Key="SliderTrackValueFill" Color="White" /><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" /><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" /></Slider.Resources></Slider>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="PlayerChoices" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="DubButton" Click="Dub_Click" Style="{StaticResource PlayerPill}" ToolTipService.ToolTip="Озвучка" AutomationProperties.Name="Озвучка"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE720;" FontSize="13" /><TextBlock x:Name="DubValue" Text="—" MaxWidth="130" TextTrimming="CharacterEllipsis" FontSize="12" /><FontIcon Glyph="&#xE70D;" FontSize="9" /></StackPanel></Button>
                <Button x:Name="QualityButton" Click="QualityMenu_Click" Style="{StaticResource PlayerPill}" ToolTipService.ToolTip="Качество" AutomationProperties.Name="Качество"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="QualityValue" Text="—" FontSize="12" /><FontIcon Glyph="&#xE70D;" FontSize="9" /></StackPanel></Button>
                <Button x:Name="SpeedButton" Click="SpeedMenu_Click" Style="{StaticResource PlayerPill}" ToolTipService.ToolTip="Скорость" AutomationProperties.Name="Скорость"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="SpeedValue" Text="×1" FontSize="12" /><FontIcon Glyph="&#xE70D;" FontSize="9" /></StackPanel></Button>
                <Button x:Name="SubtitlesButton" Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Субтитры" AutomationProperties.Name="Субтитры"><Border BorderBrush="White" BorderThickness="1.2" CornerRadius="3" Padding="2,0"><TextBlock Text="CC" FontFamily="Consolas" FontSize="11" FontWeight="Bold" /></Border>
                  <Button.Flyout><Flyout x:Name="PlayerSubtitlesFlyout" Opening="PlayerFlyout_Opening" Closed="PlayerFlyout_Closed"><StackPanel x:Name="SubtitlePopover" Width="280" Spacing="12" RequestedTheme="Dark"><TextBlock Text="СУБТИТРЫ" FontFamily="Consolas" FontSize="10" CharacterSpacing="140" Opacity="0.55" />
                    <Button x:Name="FindSubtitlesButton" Content="Найти субтитры" Click="FindSubtitles_Click" HorizontalAlignment="Stretch" Background="{StaticResource PlayerAccent}" Foreground="White" BorderThickness="0" />
                    <ScrollViewer x:Name="SubtitleChoicesScroll" MaxHeight="380" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SubtitleChoices" Spacing="2" /></ScrollViewer>
                    <Grid x:Name="SubtitleOffsetBar" ColumnSpacing="6" Visibility="Collapsed">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Button Content="−5s" Tag="-5" Click="AdjustSubtitleOffset_Click" Padding="6,4" MinHeight="26" FontSize="9" />
                      <Button Grid.Column="1" Content="−0.5s" Tag="-0.5" Click="AdjustSubtitleOffset_Click" Padding="6,4" MinHeight="26" FontSize="9" />
                      <TextBlock x:Name="SubtitleOffsetLabel" Grid.Column="2" Text="Сдвиг: 0 сек" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <Button Grid.Column="3" Content="+0.5s" Tag="0.5" Click="AdjustSubtitleOffset_Click" Padding="6,4" MinHeight="26" FontSize="9" />
                      <Button Grid.Column="4" Content="+5s" Tag="5" Click="AdjustSubtitleOffset_Click" Padding="6,4" MinHeight="26" FontSize="9" />
                      <Button Grid.Column="5" Content="Сброс" Click="ResetSubtitleOffset_Click" Foreground="{StaticResource PlayerAccent}" Padding="6,4" MinHeight="26" FontSize="9" />
                      <NumberBox x:Name="SubtitleOffset" Visibility="Collapsed" Minimum="-120" Maximum="120" Value="0" ValueChanged="SubtitleOffset_Changed" />
                    </Grid>
                    <Button Content="Открыть файл ASS / VTT" Click="LoadSubtitle_Click" />
                    <TextBlock x:Name="SubtitleStatus" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    <ComboBox x:Name="SubtitlePicker" Visibility="Collapsed" SelectionChanged="Subtitle_Changed" />
                  </StackPanel></Flyout></Button.Flyout>
                </Button>
                <Button x:Name="EpisodesButton" Click="EpisodesMenu_Click" Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Список эпизодов" AutomationProperties.Name="Список эпизодов"><FontIcon Glyph="&#xE8A4;" FontSize="18" /></Button>
                <Button Click="Fullscreen_Click" Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Во весь экран · F" AutomationProperties.Name="Полный экран"><FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="18" /></Button>
                <Button Style="{StaticResource PlayerIcon}" ToolTipService.ToolTip="Ещё" AutomationProperties.Name="Дополнительно"><FontIcon Glyph="&#xE712;" FontSize="16" /><Button.Flyout><Flyout x:Name="PlayerMoreFlyout" Opening="PlayerFlyout_Opening" Closed="PlayerFlyout_Closed"><StackPanel Spacing="8" RequestedTheme="Dark"><Button Content="Повторить загрузку" Click="RetryPlayback_Click" /><Button Content="Веб-плеер Kodik" Click="WebPlayer_Click" /><Button Content="Отметить просмотренной" Click="MarkWatched_Click" /></StackPanel></Flyout></Button.Flyout></Button>
              </StackPanel>
            </Grid>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28,0,28,170" Spacing="14">
            <Border x:Name="NextEpisodeCard" Visibility="Collapsed" Width="260" Padding="14" CornerRadius="12" Background="#D9141218" BorderBrush="#1FFFFFFF" BorderThickness="1"><StackPanel Spacing="4"><TextBlock Text="ДАЛЕЕ" FontFamily="Consolas" FontSize="9" CharacterSpacing="110" Foreground="#8CFFFFFF" /><TextBlock x:Name="NextEpisodeTitle" Foreground="White" FontSize="13" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0"><Button Content="▶  Далее" Click="NextEpisode_Click" Background="{StaticResource PlayerAccent}" Foreground="#0B0A0D" BorderThickness="0" Padding="10,5" FontSize="11" /><TextBlock x:Name="NextEpisodeCountdown" Foreground="#8CFFFFFF" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" /></StackPanel></StackPanel></Border>
            <Button x:Name="SkipOpening" Content="Пропустить опенинг  →" Click="SkipOpening_Click" Visibility="Collapsed" Style="{StaticResource PlayerPill}" HorizontalAlignment="Right" ToolTipService.ToolTip="Пропустить · S" />
            <Button x:Name="SkipEnding" Content="Пропустить эндинг  →" Click="SkipEnding_Click" Visibility="Collapsed" Style="{StaticResource PlayerPill}" HorizontalAlignment="Right" ToolTipService.ToolTip="Пропустить · S" />
          </StackPanel>
        </Grid>
        <Button x:Name="CenterPlay" Click="PlayPause_Click" Width="88" Height="88" CornerRadius="44" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Продолжить воспроизведение"><FontIcon Glyph="&#xE768;" FontSize="36" Foreground="White" /></Button>
        <ProgressRing x:Name="PlayerBuffering" Width="48" Height="48" Foreground="White" IsActive="False" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Grid Visibility="Collapsed"><ComboBox x:Name="TranslationPicker" SelectionChanged="Translation_Changed" /><ComboBox x:Name="QualityPicker" DisplayMemberPath="Quality" SelectionChanged="Quality_Changed" /><ComboBox x:Name="EpisodePicker" DisplayMemberPath="Label" SelectionChanged="Episode_Changed" /><ComboBox x:Name="SpeedPicker" SelectedIndex="2" SelectionChanged="Speed_Changed"><ComboBoxItem Content="0.5×" Tag="0.5" /><ComboBoxItem Content="0.75×" Tag="0.75" /><ComboBoxItem Content="1×" Tag="1" /><ComboBoxItem Content="1.25×" Tag="1.25" /><ComboBoxItem Content="1.4×" Tag="1.4" /><ComboBoxItem Content="1.5×" Tag="1.5" /><ComboBoxItem Content="1.75×" Tag="1.75" /><ComboBoxItem Content="2×" Tag="2" /></ComboBox></Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
      <TextBlock x:Name="StatusText" Text="WinShikiPlayer" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
    </Grid>
  </Grid>
</Window>
