<UserControl
    x:Class="WinShikiPlayer.Controls.SeekIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="24" Height="24" IsHitTestVisible="False">
    <Grid Width="24" Height="24">
        <Path x:Name="Arrow" Data="M 8 5 H 12 A 8 8 0 1 1 4 13 M 12 1 L 8 5 L 12 9"
              Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" StrokeLineJoin="Round">
            <Path.RenderTransform><ScaleTransform x:Name="Direction" CenterX="12" CenterY="12" /></Path.RenderTransform>
        </Path>
        <TextBlock x:Name="Seconds" Text="10" FontFamily="Segoe UI" FontSize="8"
                   FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Margin="0,3,0,0" />
        <Path x:Name="PlusSign" Data="M 9.25 13 H 14.75 M 12 10.25 V 15.75"
              Visibility="Collapsed" Stroke="White" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid>
</UserControl>
