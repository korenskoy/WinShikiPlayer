<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinShikiPlayer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
    <AssemblyTitle>WinShikiPlayer</AssemblyTitle>
    <Product>WinShikiPlayer</Product>
    <Version>0.2.0</Version>
    <Description>WinShikiPlayer — клиент Shikimori для Windows</Description>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <VCRTForwarders-IncludeDebugCRT>false</VCRTForwarders-IncludeDebugCRT>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(BundledApplicationConfiguration)" LogicalName="WinShikiPlayer.BundledConfiguration.json" Condition="'$(BundledApplicationConfiguration)' != ''" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.VCRTForwarders.140" Version="1.1.0" />
    <ProjectReference Include="../WinShikiPlayer.Core/WinShikiPlayer.Core.csproj" />
    <Content Include="Assets/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native/x64/libass.dll" Link="libass.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Licenses/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../appsettings.local.json" Link="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('../../appsettings.local.json')" />
  </ItemGroup>
  <Target Name="PublishWinUIResources" AfterTargets="Publish">
    <ItemGroup><WinUIResourceFiles Include="$(TargetDir)**/*.xbf;$(TargetDir)$(TargetName).pri" /></ItemGroup>
    <Copy SourceFiles="@(WinUIResourceFiles)" DestinationFiles="@(WinUIResourceFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)MainWindow.xbf')" Text="Published WinUI XBF resources are missing." />
  </Target>
</Project>
